  },
  {
   "size": 14,
   "kind": null,
   "text": "# Train with plain gradient descent\ndef train(model, data, steps=100, lr=0.01):\n    # loop over the data and update the weights\n    for step in range(steps):\n        loss = model.loss(data)\n        model.update(-lr * model.grad(loss))\n    return loss",
   "box": {
